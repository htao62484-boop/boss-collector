{
  "manifest_version": 3,
  "name": "BOSS采集助手",
  "description": "在 BOSS 消息页的有交换列表中进行可视化增量采集，支持高亮、断点与本地去重存储。",
  "version": "0.1.0",
  "permissions": ["storage", "downloads", "sidePanel", "tabs", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["https://*.zhipin.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BOSS采集助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
